{
  "version": 4,
  "configurations": [
    {
      "name": "Mac",
      "compilerPath": "/usr/bin/clang++",
      "intelliSenseMode": "macos-clang-arm64",
      "cStandard": "c17",
      "cppStandard": "c++17",
      "includePath": [
        "${workspaceFolder}/C/**"
      ],
      "macFrameworkPath": [
        "/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk/System/Library/Frameworks"
      ],
      "browse": {
        "path": [
          "${workspaceFolder}/C/**"
        ],
        "limitSymbolsToIncludedHeaders": true
      }
    }
  ]
}
